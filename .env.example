# Server
NODE_ENV=development
PORT=4000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/car-inventory

# NHTSA vPIC API
NHTSA_BASE_URL=https://vpic.nhtsa.dot.gov/api/vehicles
NHTSA_REQUEST_TIMEOUT_MS=10000
# Persist (upsert) resolved makes in chunks of this size instead of one bulk write at the end
NHTSA_INGESTION_PERSIST_BATCH_SIZE=50
# Skip re-fetching vehicle types for makes whose makeId is already persisted (safe resume). Set to
# false to force a full re-fetch/refresh of every make on every run.
NHTSA_INGESTION_SKIP_EXISTING=true

# Logging
LOG_LEVEL=info
