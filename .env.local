# Server
NODE_ENV=development
PORT=4000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/car-inventory

# NHTSA vPIC API
NHTSA_BASE_URL=https://vpic.nhtsa.dot.gov/api/vehicles
NHTSA_REQUEST_TIMEOUT_MS=10000
NHTSA_INGESTION_PERSIST_BATCH_SIZE=50
NHTSA_INGESTION_SKIP_EXISTING=true

# Logging
LOG_LEVEL=info

# Feature flags
FEATURE_INGEST_ON_STARTUP=false
